---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Hero from "@/components/home/Hero.astro";
import Statement from "@/components/home/Statement.astro";
import Experience from "@/components/home/Experience.astro";
import Projects from "@/components/home/Projects.astro";
import Stack from "@/components/home/Stack.astro";
import Principles from "@/components/home/Principles.astro";
import Closing from "@/components/home/Closing.astro";
import { validatePortfolioContent } from "@/lib/portfolio-content";
import { DATA } from "@/data/resume";
import "@/styles/home.css";

validatePortfolioContent();
---

<Layout bleed stage intro>
  <div class="stage-canvas" data-stage aria-hidden="true"></div>
  <Hero />
  <div class="sheet" data-sheet>
    <Statement />
    <Experience />
    <Projects projects={DATA.projects} intro={DATA.sections.projects.text} />
    <Stack />
    <Principles />
  </div>
  <Closing />
  <script>import "../scripts/home";</script>
</Layout>
