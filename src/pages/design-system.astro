---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import ThemeSwitch from "@/components/design/ThemeSwitch.astro";
import { THEMES } from "@/design/tokens";
import { DATA } from "@/data/resume";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { Input, Textarea } from "@/components/ui/input";
import { SectionHeading } from "@/components/design/SectionHeading";
import { ProjectCard } from "@/components/project-card";
import WorkSection from "@/components/section/work-section";
import { EmptyState, LoadingState } from "@/components/design/States";
import { GalleryTabs, GalleryFilters } from "@/components/design/GalleryControls";
const swatches = ["background", "foreground", "card", "primary", "secondary", "muted", "muted-foreground", "border", "input", "warm", "ring", "disabled-background"] as const;
---
<Layout title="Design system" description="The visual language and interface components of Rokon’s portfolio." noindex>
  <div class="blog-header"><p class="eyebrow">Rokon / Design system</p><h1 class="page-title">A system with<br />a point of view<span class="text-primary">.</span></h1><p class="section-description">Mint and teal from the logo, an ink taken from the portrait’s navy, and one typeface drawn narrow for headings and at its normal width for text. The same language, in light and dark.</p><div class="mt-6"><ThemeSwitch /></div></div>
  <section class="gallery-section" aria-labelledby="palette-heading"><h2 id="palette-heading">01 / Color & surfaces</h2><p class="section-description mb-6">Each swatch follows the active theme. Interactive and reading colors have verified contrast pairings.</p><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">{swatches.map((token) => <div class="gallery-swatch"><div class="gallery-swatch-color" style={`background:var(--${token})`} aria-hidden="true"></div><div class="gallery-swatch-label"><span class="text-sm">{token}</span><span class="metadata">Light {THEMES.light[token]}</span><span class="metadata">Dark {THEMES.dark[token]}</span></div></div>)}</div></section>
  <section class="gallery-section" aria-labelledby="type-heading"><h2 id="type-heading">02 / Type & hierarchy</h2><p class="metadata mb-3">Display / Mona Sans, narrow and heavy</p><p class="display-title font-display mb-8">Screens, APIs,<br /><span class="text-primary">and the pipelines.</span></p><div class="gallery-grid"><div><p class="eyebrow mb-3">Body / Mona Sans, normal width</p><p>Readable at every size. Body text stays comfortably spaced, with a narrow measure for extended reading and clear separation between ideas.</p></div><div><p class="eyebrow mb-3">Code / IBM Plex Mono</p><p class="metadata">Used for code and endpoint excerpts only.</p><pre class="bg-card border rounded-lg p-4 mt-3 overflow-auto text-sm font-mono"><code>{"const system = { clarity: true };"}</code></pre></div></div></section>
  <section class="gallery-section" aria-labelledby="buttons-heading"><h2 id="buttons-heading">03 / Actions & technical badges</h2><div class="flex flex-wrap items-center gap-3"><Button asChild><a href="/#projects">Explore work <span aria-hidden="true">↗</span></a></Button><Button asChild variant="secondary"><a href="/blog">Read the notes</a></Button><Button asChild variant="outline"><a href="/#contact">Let's connect</a></Button><Button asChild variant="ghost"><a href="/">Overview</a></Button><Button disabled>Unavailable</Button><a class="text-link text-sm" href="/#experience">View experience ↗</a></div><div class="flex flex-wrap gap-2 mt-6"><Badge>TypeScript</Badge><Badge>Spring Boot</Badge><Badge variant="default">Selected</Badge><Badge variant="secondary">Technical note</Badge><Badge variant="destructive">Error</Badge></div></section>
  <section class="gallery-section" aria-labelledby="headings-heading"><h2 id="headings-heading">04 / Section headings</h2><SectionHeading index="02" eyebrow="Personal projects" title="Selected personal work" description="A numbered index, a small contextual label, and one clear heading. Decoration never carries the only meaning." /></section>
  <section class="gallery-section" aria-labelledby="projects-heading"><h2 id="projects-heading">05 / Editorial project rows</h2><ProjectCard project={DATA.projects[0]} index={1} /></section>
  <section class="gallery-section" aria-labelledby="controls-heading"><h2 id="controls-heading">06 / Tabs & filters</h2><div class="gallery-grid"><GalleryTabs client:visible /><GalleryFilters client:visible projects={DATA.projects} /></div><noscript><p class="field-hint mt-4">Tabs and filters need JavaScript. The initial panel and complete project list are shown above.</p></noscript></section>
  <section class="gallery-section" aria-labelledby="blog-heading"><h2 id="blog-heading">07 / Blog card anatomy</h2><p class="field-hint mb-6">Component specimen. This example is not a published article.</p><article class="blog-card"><span class="metadata">Publication date</span><div><h3><a class="blog-card-title" href="/blog">Engineering note title <span class="text-primary" aria-hidden="true">↗</span></a></h3><p class="mt-3">A short, useful summary sits beside quiet metadata. The title is a normal link with visible keyboard focus.</p></div></article></section>
  <section class="gallery-section" aria-labelledby="timeline-heading"><h2 id="timeline-heading">08 / Experience timeline</h2><WorkSection work={[DATA.work[0]]} presentLabel="Present" /></section>
  <section class="gallery-section" aria-labelledby="forms-heading"><h2 id="forms-heading">09 / Form inputs</h2><p class="field-hint mb-6">Input specimens only; this page does not send or store messages.</p><div class="gallery-grid"><div class="space-y-5"><div class="field"><label for="specimen-name">Name</label><Input id="specimen-name" placeholder="Your name" aria-describedby="name-hint" /><p id="name-hint" class="field-hint">Labels stay visible after typing.</p></div><div class="field"><label for="specimen-email">Email address <span class="field-error">(error state)</span></label><Input id="specimen-email" type="email" defaultValue="incomplete@" aria-invalid="true" aria-describedby="email-error" /><p id="email-error" class="field-error">Error: enter a complete email address.</p></div><div class="field"><label for="specimen-disabled">Unavailable field</label><Input id="specimen-disabled" defaultValue="Not editable" disabled /></div></div><div class="field self-start"><label for="specimen-message">Message</label><Textarea id="specimen-message" placeholder="A little context goes a long way." aria-describedby="message-hint" /><p id="message-hint" class="field-hint">Comfortable input spacing. Clear focus. No hidden labels.</p></div></div></section>
  <section class="gallery-section" aria-labelledby="states-heading"><h2 id="states-heading">10 / Loading & empty states</h2><div class="gallery-grid"><LoadingState label="Loading specimen" /><EmptyState title="Nothing here yet." description="An empty state explains what is missing and provides a useful next step." href="/#projects" label="Explore the projects" /></div></section>
</Layout>
