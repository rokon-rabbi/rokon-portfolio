---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { PROFILE } from "@/data/profile";
import { LOCATION } from "@/data/about";
import { CONTACT_DETAILS, emailHref } from "@/data/contact";
import "@/styles/profile-pages.css";
const github = PROFILE.contacts.find((contact) => contact.id === "github")!;
const { email, linkedin } = CONTACT_DETAILS;
---
<Layout title="Contact" description="Connect with Rokon about full-stack software engineering, collaboration, or a software engineering role.">
  <div class="profile-page contact-page">
    <section class="contact-masthead" aria-labelledby="contact-title" data-motion="reveal">
      <p class="eyebrow">Contact</p>
      <h1 id="contact-title" class="profile-title">Tell me what you’re working on.</h1>
      <p class="lede">A role, a project, or a technical question. A few lines about your team and what you need is a good start.</p>
    </section>
    <section class="contact-desk" aria-labelledby="contact-options-heading">
      <div class="contact-desk-main">
        <h2 id="contact-options-heading" class="eyebrow">Email</h2>
        {email
          ? <>
              <a class="contact-email" href={emailHref(email)}>{email}</a>
              <p class="metadata contact-clock" data-local-clock data-time-zone={LOCATION.timeZone} hidden>It’s <time data-local-time></time> in {LOCATION.city} right now.</p>
              <div class="profile-actions"><a class="button button-primary" href={emailHref(email, "Software engineering role")}>Write about a role <span class="arrow arrow-right" aria-hidden="true"></span></a><a class="button button-outline" href={emailHref(email, "A project")}>Write about a project <span class="arrow arrow-right" aria-hidden="true"></span></a></div>
            </>
          : <div class="profile-actions"><a class="button button-primary" href={github.url}>Visit my GitHub profile <span class="arrow" aria-hidden="true"></span></a></div>}
      </div>
      <nav class="contact-channels" aria-label="Elsewhere">
        <a class="contact-channel" href={github.url}><span class="channel-title">GitHub</span><span class="metadata">rokon-rabbi · code and projects</span><span class="arrow" aria-hidden="true"></span></a>
        {linkedin && <a class="contact-channel" href={linkedin}><span class="channel-title">LinkedIn</span><span class="metadata">Experience and background</span><span class="arrow" aria-hidden="true"></span></a>}
        <a class="contact-channel" href="/work"><span class="channel-title">Work</span><span class="metadata">Projects and case studies</span><span class="arrow arrow-right" aria-hidden="true"></span></a>
        <a class="contact-channel" href="/resume"><span class="channel-title">Résumé</span><span class="metadata">Experience, skills and education on one page</span><span class="arrow arrow-right" aria-hidden="true"></span></a>
      </nav>
    </section>
  </div>
</Layout>
