---
export const prerender = true;
import { getImage } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import ResumeLinks from "@/components/design/ResumeLinks.astro";
import { ABOUT, EDUCATION } from "@/data/about";
import { PROFILE } from "@/data/profile";
import { EXPERIENCE } from "@/data/experience";
import { SKILL_GROUPS } from "@/data/skills";
import { CONTACT_DETAILS } from "@/data/contact";
import { formatEmploymentMonth } from "@/lib/portfolio-dates";
import { validatePortfolioContent } from "@/lib/portfolio-content";
import portrait from "@/assets/brand/rokon-cutout.webp";
import "@/styles/profile-pages.css";
validatePortfolioContent();
// Shown at 160 CSS pixels at most; twice that for sharp screens.
const small = await getImage({ src: portrait, width: 160, format: "webp", quality: 84 });
const large = await getImage({ src: portrait, width: 320, format: "webp", quality: 82 });
---
<Layout title="About" description="Meet Rokon, a full-stack software engineer working across frontend applications, backend systems, and software delivery.">
  <div class="profile-page">
    <section class="profile-masthead" aria-labelledby="about-title" data-motion="reveal">
      <div>
        <p class="eyebrow">About</p>
        <h1 id="about-title" class="profile-title">I care about how the pieces fit together.</h1>
        <p class="lede">{ABOUT.introduction}</p>
        <ResumeLinks />
      </div>
      <figure class="profile-portrait">
        <div class="profile-portrait-frame"><img src={small.src} srcset={`${small.src} 160w, ${large.src} 320w`} sizes="(min-width: 40rem) 10rem, 8.5rem" width={small.attributes.width} height={small.attributes.height} alt={`Portrait of ${PROFILE.name}`} fetchpriority="high" decoding="async" /></div>
      </figure>
    </section>

    <section class="profile-section profile-split" aria-labelledby="approach-heading">
      <div class="profile-section-label"><h2 id="approach-heading">How I like to work.</h2></div>
      <div class="profile-section-content">
        <p class="profile-body">{ABOUT.context}</p>
        <p class="profile-body">That work spans user-facing features, backend integration, and delivery. I try to keep the whole workflow in view and make each part easier to understand.</p>
        <ul class="principle-list">{ABOUT.principles.map((principle) => <li><h3>{principle.title}</h3><p>{principle.text}</p></li>)}</ul>
      </div>
    </section>

    <section class="profile-section profile-split" aria-labelledby="career-heading">
      <div class="profile-section-label"><h2 id="career-heading">Where I’ve worked.</h2></div>
      <ol class="career-list">{EXPERIENCE.map((role) => <li class="career-entry"><p class="metadata"><time datetime={role.start}>{formatEmploymentMonth(role.start)}</time> – {role.end ? <time datetime={role.end}>{formatEmploymentMonth(role.end)}</time> : "Present"}</p><h3>{role.company}</h3><p class="career-company">{role.title}</p><p class="profile-body">{role.summary}</p><ul class="career-contributions">{role.contributions.map((claim) => <li>{claim.text}</li>)}</ul>{role.technologies.length > 0 && <div class="skill-badges">{role.technologies.map((skill) => <span class="technical-badge">{skill}</span>)}</div>}</li>)}</ol>
    </section>

    <section class="profile-section profile-split" aria-labelledby="focus-heading">
      <div class="profile-section-label"><h2 id="focus-heading">What I’m getting better at.</h2></div>
      <ul class="focus-list">{ABOUT.focus.map((focus) => <li><h3>{focus.title}</h3><p>{focus.text}</p></li>)}</ul>
    </section>

    <section class="profile-section profile-split" aria-labelledby="education-heading">
      <div class="profile-section-label"><h2 id="education-heading">Where I studied.</h2></div>
      <div class="education-entry">{EDUCATION.period && <p class="metadata">{EDUCATION.period}</p>}<h3>{EDUCATION.degree ?? "NSTU"}</h3><p class="profile-body">{EDUCATION.institution}</p></div>
    </section>

    <section class="profile-section profile-split" aria-labelledby="skills-heading">
      <div class="profile-section-label"><h2 id="skills-heading">What I reach for.</h2></div>
      <div><dl class="profile-skills">{SKILL_GROUPS.map((group) => <div><dt>{group.label}</dt><dd class="skill-badges">{group.skills.map((skill) => <span class="technical-badge">{skill}</span>)}</dd></div>)}</dl><div class="development-interests"><h3>Things I want to keep exploring</h3><ul>{ABOUT.interests.map((interest) => <li>{interest}</li>)}</ul></div></div>
    </section>

    <section class="profile-closing" aria-labelledby="about-connect-heading"><h2 id="about-connect-heading">Have something in mind?</h2><div><p class="profile-body">I’m glad to talk about full-stack engineering, working together, and software engineering roles.</p><div class="profile-actions"><a class="button button-primary" href="/contact">Let’s talk <span class="arrow arrow-right" aria-hidden="true"></span></a>{PROFILE.contacts.map((contact) => <a class="text-link" href={contact.url}>{contact.label} <span class="arrow" aria-hidden="true"></span></a>)}{CONTACT_DETAILS.linkedin && <a class="text-link" href={CONTACT_DETAILS.linkedin}>LinkedIn <span class="arrow" aria-hidden="true"></span></a>}</div></div></section>
  </div>
</Layout>
