---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Page not found" description="This page could not be found. Return to Rokon's portfolio or explore selected engineering projects." noindex>
  <section class="error-page">
    <div class="error-code" aria-hidden="true">{"{ 404 }"}</div>
    <h1>There’s nothing at this address.</h1>
    <p>The page has moved or never existed. The home page and the work page are both a good place to start again.</p>
    <div class="flex flex-wrap gap-3"><a href="/" class="button button-primary">Go home <span class="arrow arrow-right" aria-hidden="true"></span></a><a href="/#projects" class="button button-outline">See my work</a></div>
  </section>
</Layout>
