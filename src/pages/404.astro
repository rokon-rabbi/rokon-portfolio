---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Page not found" description="This page could not be found. Return to Rokon's portfolio or explore selected engineering projects." noindex>
  <section class="error-page">
    <div class="error-code" aria-hidden="true">[ 404 / disconnected path ]</div>
    <h1>This connection<br />leads nowhere<span class="text-primary">.</span></h1>
    <p>The page you're looking for has moved or doesn't exist. Let's get you back to a working path.</p>
    <div class="flex flex-wrap gap-3"><a href="/" class="button button-primary">Back to overview <span aria-hidden="true">↗</span></a><a href="/#projects" class="button button-outline">Explore my work</a></div>
  </section>
</Layout>
