---
export const prerender = true;
import ArticlePage from "@/components/blog/ArticlePage.astro";
import { getPublishedPosts } from "@/lib/blog";
export async function getStaticPaths() {
  const published = await getPublishedPosts();
  return published.map((post) => ({ params: { slug: post.id }, props: { post, published } }));
}
const { post, published } = Astro.props;
---
<ArticlePage post={post} published={published} />
