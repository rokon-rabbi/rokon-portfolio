---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import BlogArchive from "@/components/blog/BlogArchive.astro";
import { getPublishedPosts } from "@/lib/blog";
import { articleSummary } from "@/lib/blog-publication";
const articles = (await getPublishedPosts()).map(articleSummary);
---
<Layout title="Engineering notes" description="Thoughtful writing on software delivery, backend systems, and maintainable interfaces by Md. Rokonuzzaman.">
  <BlogArchive articles={articles} />
</Layout>
