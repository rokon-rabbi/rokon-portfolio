---
import "../styles/global.css";
import { DATA } from "@/data/resume";
import { CONFIG } from "@/data/config";
import SiteHeader from "@/components/design/SiteHeader.astro";
import SiteFooter from "@/components/design/SiteFooter.astro";
import { THEME_CSS } from "@/design/tokens";
import { canonicalUrl, pageSchema, serializeSchema, socialPreviewImage } from "@/lib/seo";
import sansFont from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: { publishedTime: string; modifiedTime: string; author: string; tags: string[] };
  canonicalURL?: string;
  noindex?: boolean;
  /** The page places its own containers, so sections can run edge to edge. */
  bleed?: boolean;
  /** The page opens on the dark stage and slides under the header. */
  stage?: boolean;
  /** The page opens with an entrance; its first screen waits for the motion module. */
  intro?: boolean;
  /** An image the first screen depends on. */
  preloadImage?: string;
}

const {
  title,
  noindex = false,
  bleed = false,
  stage = false,
  intro = false,
  preloadImage,
  description = DATA.description,
  image,
  imageAlt,
  article,
  canonicalURL = canonicalUrl(Astro.url.pathname),
} = Astro.props;

const pageTitle = title
  ? CONFIG.seo.titleTemplate.replace("%s", title).replace("%n", DATA.name)
  : `${DATA.name} | ${DATA.headline}`;
const previewImage = socialPreviewImage(image);
const defaultPreview = previewImage === "/images/social-card.png";
const ogImage = new URL(previewImage, CONFIG.site.url).href;
const socialAlt = (!defaultPreview && imageAlt) || "Md. Rokonuzzaman — Full-Stack Software Engineer. Frontend, APIs, and delivery.";
const schema = serializeSchema(pageSchema(canonicalURL, title || "Overview"));

const { baseFontSize } = CONFIG.typography;
---

<html
  lang={CONFIG.site.locale.split("_")[0]}
  style={`font-size: ${baseFontSize}%;`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}

    <script is:inline>
      (function () {
        var saved = null;
        try { var value = localStorage.getItem("theme"); if (value === "dark" || value === "light") saved = value; } catch (_) {}
        var mode = saved || "light";
        document.documentElement.dataset.theme = mode;
        document.documentElement.classList.toggle("dark", mode === "dark");
        document.documentElement.style.colorScheme = mode;
      })();
    </script>
    {intro && (
      <script is:inline>
        // The first screen starts hidden only when motion is welcome. If the
        // motion module never arrives, the finished page appears on its own.
        (function () {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          var root = document.documentElement;
          root.classList.add("intro-pending");
          setTimeout(function () { root.classList.remove("intro-pending"); }, 2400);
        })();
      </script>
    )}
    <style is:inline set:html={THEME_CSS}></style>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Primary meta -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Rokon — Engineering notes" href="/rss.xml" />

    <!-- Robots -->
    <meta name="robots" content={noindex ? "noindex, follow" : CONFIG.seo.robots} />
    <meta
      name="googlebot"
      content={noindex ? "noindex, follow" : "index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}
    />

    <!-- OpenGraph -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={DATA.name} />
    <meta property="og:locale" content={CONFIG.site.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:image:alt" content={socialAlt} />
    {defaultPreview && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:type" content="image/png" /></>}
    {article && <>
      <meta property="article:published_time" content={`${article.publishedTime}T00:00:00Z`} />
      <meta property="article:modified_time" content={`${article.modifiedTime}T00:00:00Z`} />
      <meta name="author" content={article.author} />
      {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    </>}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : CONFIG.seo.twitterCard} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="twitter:image:alt" content={socialAlt} />
    {!noindex && <script is:inline data-site-schema type="application/ld+json" set:html={schema} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class:list={[bleed ? "page-bleed" : "site-container page-content", { "page-stage": stage }]} tabindex="-1"><slot /></main>
    <SiteFooter />
    <script>import "../scripts/theme";</script>
    <script>import "../scripts/motion";</script>
  </body>
</html>
