---
import { EXPERIENCE } from "@/data/experience";

const month = (value: string) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${value}-01T00:00:00Z`));
---
<section id="experience" class="home-section" aria-labelledby="experience-heading">
  <h2 id="experience-heading">Experience</h2>
  <ol class="rows">
    {EXPERIENCE.map((role) => (
      <li class="row">
        <p class="row-label"><time datetime={role.start}>{month(role.start)}</time> – {role.end ? <time datetime={role.end}>{month(role.end)}</time> : "Now"}</p>
        <div class="row-body">
          <h3>{role.title}</h3>
          <p class="row-sub">{role.company}</p>
          <ul class="row-points">{role.contributions.map((claim) => <li>{claim.text}</li>)}</ul>
          {role.technologies.length > 0 && <ul class="tools" aria-label="Technologies">{role.technologies.map((skill) => <li>{skill}</li>)}</ul>}
        </div>
      </li>
    ))}
  </ol>
</section>
