---
import { FeaturedProject } from "@/components/design/FeaturedProject";
import { DATA } from "@/data/resume";
import { workHref } from "@/lib/work";

const projects = DATA.projects.filter((project) => project.featured);
---
<section id="projects" class="home-section" aria-labelledby="projects-heading">
  <div class="site-container">
    <div class="section-top">
      <div>
        <p class="eyebrow" data-rise>Projects</p>
        <h2 id="projects-heading" class="section-title" data-lines>Things I’ve built on my own time.</h2>
      </div>
      <p class="section-note" data-rise>Outside of work. Each one has its code and a case study written from the public source.</p>
    </div>
    <div class="featured-projects">
      {projects.map((project) => <FeaturedProject project={project} caseStudyHref={workHref(project)} />)}
    </div>
    <p class="section-after" data-rise><a class="button button-outline" href="/work">Projects and case studies <span class="arrow arrow-right" aria-hidden="true"></span></a></p>
  </div>
</section>
