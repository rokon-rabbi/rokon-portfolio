---
import { EDUCATION } from "@/data/about";
---
<section id="education" class="home-section" aria-labelledby="education-heading">
  <h2 id="education-heading">Education</h2>
  <div class="row">
    <p class="row-label">{EDUCATION.period}</p>
    <div class="row-body">
      <h3>{EDUCATION.degree ?? EDUCATION.institution}</h3>
      {EDUCATION.degree && <p class="row-sub">{EDUCATION.institution}</p>}
    </div>
  </div>
</section>
