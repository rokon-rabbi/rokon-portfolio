---
/**
 * The small pictures that sit inside the headline and beside each layer of
 * the stack: a screen, an API, a store of data, a pipeline, a server.
 */
interface Props {
  kind: "screen" | "api" | "data" | "pipeline" | "server";
}
const { kind } = Astro.props;
---
<span class:list={["token", `token-${kind}`]} aria-hidden="true">
  <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    {kind === "screen" && (
      <>
        <rect x="7" y="9" width="26" height="22" rx="4" />
        <path d="M7 16h26" />
        <path class="token-fill" d="M12.5 22.5h8M12.5 26.5h13" />
      </>
    )}
    {kind === "api" && (
      <>
        <path d="M16 9c-3.5 0-4.5 1.6-4.5 4.5v2.5c0 2.2-1.2 3.5-3.5 4 2.3.5 3.5 1.8 3.5 4v2.5c0 2.9 1 4.5 4.5 4.5" />
        <path d="M24 9c3.5 0 4.5 1.6 4.5 4.5v2.5c0 2.2 1.2 3.5 3.5 4-2.3.5-3.5 1.8-3.5 4v2.5c0 2.9-1 4.5-4.5 4.5" />
        <path class="token-fill" d="M17.5 20h.01M22.5 20h.01" stroke-width="3" />
      </>
    )}
    {kind === "data" && (
      <>
        <ellipse cx="20" cy="12" rx="10" ry="4" />
        <path d="M10 12v16c0 2.2 4.5 4 10 4s10-1.8 10-4V12" />
        <path class="token-fill" d="M10 20c0 2.2 4.5 4 10 4s10-1.8 10-4" />
      </>
    )}
    {kind === "server" && (
      <>
        <rect x="8" y="8" width="24" height="10" rx="3" />
        <rect x="8" y="22" width="24" height="10" rx="3" />
        <path class="token-fill" d="M13.5 13h.01M13.5 27h.01" stroke-width="3" />
        <path d="M19 13h8M19 27h8" />
      </>
    )}
    {kind === "pipeline" && (
      <>
        <path d="M12.5 20h4M23.5 20h4" />
        <circle class="token-step" cx="9" cy="20" r="3.5" />
        <circle class="token-step" cx="20" cy="20" r="3.5" />
        <circle class="token-step" cx="31" cy="20" r="3.5" />
      </>
    )}
  </svg>
</span>
