---
import { getImage } from "astro:assets";
import { ABOUT, EDUCATION, LOCATION } from "@/data/about";
import { PROFILE } from "@/data/profile";
import portrait from "@/assets/brand/rokon-cutout.webp";

// Shown at 320 CSS pixels at most; twice that for sharp screens.
const small = await getImage({ src: portrait, width: 360, format: "webp", quality: 82 });
const large = await getImage({ src: portrait, width: 720, format: "webp", quality: 80 });
---
<section id="about" class="home-section" aria-labelledby="about-heading">
  <div class="site-container about">
    <figure class="portrait" data-rise>
      <img src={small.src} srcset={`${small.src} 360w, ${large.src} 720w`} sizes="(min-width: 60rem) 20rem, 14rem" width={small.attributes.width} height={small.attributes.height} alt={`Portrait of ${PROFILE.name}`} loading="lazy" decoding="async" />
    </figure>
    <div class="about-copy">
      <h2 id="about-heading" class="eyebrow" data-rise>About</h2>
      <p class="about-statement" data-words>{ABOUT.introduction}</p>
      <dl class="about-facts" data-rise>
        {EDUCATION.degree && <div><dt>Education</dt><dd>{EDUCATION.degree}<br />{EDUCATION.institution.replace(" (NSTU)", "")}{EDUCATION.period && `, ${EDUCATION.period.replace(/\s/g, "")}`}</dd></div>}
        <div><dt>Based in</dt><dd>{LOCATION.city}, {LOCATION.country}</dd></div>
      </dl>
      <p data-rise><a class="button button-outline" href="/about">More about me <span class="arrow arrow-right" aria-hidden="true"></span></a></p>
    </div>
  </div>
</section>
