---
import { PROFILE } from "@/data/profile";
import { LOCATION } from "@/data/about";
import { CONTACT_DETAILS, emailHref } from "@/data/contact";

const { email, linkedin } = CONTACT_DETAILS;
const github = PROFILE.contacts.find((contact) => contact.id === "github");
---
<section id="contact" class="home-section" aria-labelledby="contact-heading" data-reveal>
  <h2 id="contact-heading">Contact</h2>
  <p class="contact-text">I’m glad to hear about a role, a project, or a problem you are stuck on. Email is the quickest way to reach me.</p>
  {email && (
    <p class="contact-line">
      <a class="contact-address" href={emailHref(email)}>{email}</a>
      <button type="button" class="copy-button" data-copy-button data-copy={email} aria-label="Copy email address" hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect class="copy-icon" x="9" y="9" width="11" height="11" rx="2" /><path class="copy-icon" d="M15 5.5V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h.5" /><path class="copied-icon" d="m5 12.5 4.5 4.5L19 7.5" /></svg>
        <span data-copy-label aria-live="polite">Copy</span>
      </button>
    </p>
  )}
  <p class="contact-clock" data-local-clock data-time-zone={LOCATION.timeZone} hidden>It’s <time data-local-time></time> in {LOCATION.city} right now.</p>
  <p class="link-row">
    {!email && <a class="text-link" href="/contact">Get in touch <span class="arrow arrow-right" aria-hidden="true"></span></a>}
    {linkedin && <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="arrow" aria-hidden="true"></span></a>}
    {github && <a class="text-link" href={github.url} target="_blank" rel="noopener noreferrer">GitHub <span class="arrow" aria-hidden="true"></span></a>}
  </p>
</section>
