---
interface Props {
  articles: { id: string; title: string; publishedAt: string }[];
}
const { articles } = Astro.props;
const day = (value: string) =>
  new Date(`${value}T00:00:00Z`).toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
---
<section id="writing" class="home-section" aria-labelledby="writing-heading">
  <h2 id="writing-heading">Writing</h2>
  <ul class="rows rows-tight">
    {articles.map((article) => (
      <li class="row">
        <time class="row-label" datetime={article.publishedAt}>{day(article.publishedAt)}</time>
        <a class="row-title-link" href={`/blog/${article.id}`}>{article.title}</a>
      </li>
    ))}
  </ul>
  <p class="link-row section-more"><a class="text-link" href="/blog">All notes <span class="arrow arrow-right" aria-hidden="true"></span></a></p>
</section>
