---
import { LOCATION } from "@/data/about";
import { PROFILE } from "@/data/profile";
import { CONTACT_DETAILS, emailHref } from "@/data/contact";

const { email, linkedin } = CONTACT_DETAILS;
const github = PROFILE.contacts.find((contact) => contact.id === "github");
---
<section class="intro" aria-labelledby="intro-title">
  <h1 id="intro-title">Hi, I’m Rokon.</h1>
  <p class="intro-text">I’m a full-stack software engineer in {LOCATION.city}. I build web apps end to end: the screens people use, the APIs behind them, and the pipelines that ship them.</p>
  <p class="link-row intro-links">
    <a class="text-link" href="/resume">Résumé <span class="arrow arrow-right" aria-hidden="true"></span></a>
    {github && <a class="text-link" href={github.url} target="_blank" rel="noopener noreferrer">GitHub <span class="arrow" aria-hidden="true"></span></a>}
    {linkedin && <a class="text-link" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="arrow" aria-hidden="true"></span></a>}
    {email && <a class="text-link" href={emailHref(email)}>Email</a>}
  </p>
</section>
