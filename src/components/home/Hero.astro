---
import Tokens from "./Tokens.astro";
import { BRACE_PATH, BRACE_VIEWBOX } from "@/design/brace";
import { EXPERIENCE } from "@/data/experience";
import { EDUCATION, LOCATION } from "@/data/about";
import { PROFILE } from "@/data/profile";

const [current, previous] = EXPERIENCE;
// Short forms for the facts beside the headline; the full titles and company
// names are in the experience section below.
const role = (title: string) => title.replace(/\s*\(.*\)$/, "");
const company = (name: string) => name.replace(/\s*(\(BD\)\s*)?Limited$/, "");
const github = PROFILE.contacts.find((contact) => contact.id === "github");
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="site-container hero-inner">
    <div class="hero-main">
      <h1 id="hero-title" class="hero-title" data-hero-title>
        <span class="hero-ink">Hi, I’m Rokon.</span> I build web apps end to end: the <span class="hero-ink hero-word"><Tokens kind="screen" />screens</span> people use, the <span class="hero-ink hero-word"><Tokens kind="api" />APIs</span> behind them, and the <span class="hero-ink hero-word"><Tokens kind="pipeline" />pipelines</span> that ship them.
      </h1>
      <div class="hero-actions" data-intro>
        <a class="button button-primary button-lg" href="#experience" data-magnetic>See my experience <span class="arrow arrow-down" aria-hidden="true"></span></a>
        <a class="text-link" href="/resume">Résumé <span class="arrow arrow-right" aria-hidden="true"></span></a>
        {github && <a class="text-link" href={github.url} target="_blank" rel="noopener noreferrer">GitHub <span class="arrow" aria-hidden="true"></span></a>}
      </div>
    </div>
    <aside class="hero-facts" aria-label="At a glance">
      <span class="hero-brace" data-anchor="brace-open" aria-hidden="true"><svg viewBox={BRACE_VIEWBOX} fill="none"><path d={BRACE_PATH} /></svg></span>
      <dl class="facts" data-hero-facts>
        <div><dt>Now</dt><dd>{role(current.title)}<span class="fact-aside">{company(current.company)}</span></dd></div>
        <div><dt>Before</dt><dd>{role(previous.title)}<span class="fact-aside">{company(previous.company)}</span></dd></div>
        <div><dt>Studied</dt><dd>Software Engineering<span class="fact-aside">NSTU{EDUCATION.period && `, ${EDUCATION.period.replace(/\s/g, "")}`}</span></dd></div>
        <div><dt>Based in</dt><dd>{LOCATION.city}, {LOCATION.country}<span class="fact-aside" data-local-clock data-time-zone={LOCATION.timeZone} hidden><time data-local-time></time> there now</span></dd></div>
      </dl>
      <span class="hero-brace hero-brace-close" data-anchor="brace-close" aria-hidden="true"><svg viewBox={BRACE_VIEWBOX} fill="none"><path d={BRACE_PATH} /></svg></span>
    </aside>
  </div>
</section>
<script>
  // A brace is a third as wide as it is tall. Each one is given exactly that
  // much room, so the pair clears the facts at any width and text size.
  const facts = document.querySelector<HTMLElement>(".hero-facts");
  const list = facts?.querySelector<HTMLElement>(".facts");
  if (facts && list && "ResizeObserver" in window) {
    let width = 0;
    const fit = () => {
      const next = Math.round(list.offsetHeight * 0.34);
      if (next === width) return;
      width = next;
      facts.style.setProperty("--brace-width", `${next}px`);
    };
    new ResizeObserver(() => requestAnimationFrame(fit)).observe(list);
    fit();
  }
</script>
