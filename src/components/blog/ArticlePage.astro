---
import { render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ArticleCard from "./ArticleCard.astro";
import { mdxComponents } from "@/mdx-components";
import { CONFIG } from "@/data/config";
import { socialPreviewImage } from "@/lib/seo";
import { PROFILE } from "@/data/profile";
import { articleSummary, articleHref, blogDate, BLOG_TOPICS, relatedArticles, tagHref, tagLabel } from "@/lib/blog-publication";
interface Props { post: CollectionEntry<"blog">; published: CollectionEntry<"blog">[]; preview?: boolean; }
const { post, published, preview = false } = Astro.props;
const { Content, headings } = await render(post);
const article = articleSummary(post);
const toc = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const chronological = [...published].reverse();
const index = chronological.findIndex((entry) => entry.id === post.id);
const previous = index > 0 ? chronological[index - 1] : undefined;
const next = index >= 0 ? chronological[index + 1] : undefined;
const related = preview ? [] : relatedArticles(post, published);
const canonicalURL = new URL(articleHref(post.id), CONFIG.site.url).href;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org", "@type": "BlogPosting", headline: article.title,
  description: article.description, datePublished: article.date,
  dateModified: article.updatedDate ?? article.date, url: canonicalURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
  author: { "@type": "Person", name: article.author,
    ...(article.author === PROFILE.name ? { "@id": `${CONFIG.site.url}/#person`, url: `${CONFIG.site.url}/about` } : {}) },
  image: new URL(socialPreviewImage(article.coverImage), CONFIG.site.url).href,
  keywords: article.tags.map(tagLabel), articleSection: BLOG_TOPICS[article.topic], inLanguage: "en",
}).replace(/</g, "\\u003c");
---
<Layout title={article.title} description={article.description} image={article.coverImage} imageAlt={article.coverAlt} canonicalURL={canonicalURL} noindex={preview} article={preview ? undefined : { publishedTime: article.date, modifiedTime: article.updatedDate ?? article.date, author: article.author, tags: article.tags.map(tagLabel) }}>
  <article class="publication-article" aria-labelledby="article-title">
    {!preview && <script is:inline data-article-schema type="application/ld+json" set:html={jsonLd} />}
    {preview && <aside class="article-preview-notice"><p class="eyebrow">Local draft preview, unpublished</p><p>This text is awaiting approval. The examples describe proposed engineering patterns, not verified personal project outcomes.</p></aside>}
    <a class="text-link article-back" href="/blog">All notes</a>
    <header class="article-header">
      <p class="eyebrow">{BLOG_TOPICS[article.topic]}</p>
      <h1 id="article-title">{article.title}</h1>
      <p class="article-deck">{article.description}</p>
      <div class="article-byline"><span>{article.author}</span><span>{preview ? "Proposed date" : "Published"} <time datetime={article.date}>{blogDate(article.date)}</time></span>{article.updatedDate && article.updatedDate !== article.date && <span>Updated <time datetime={article.updatedDate}>{blogDate(article.updatedDate)}</time></span>}<span>{article.readingMinutes} min read <span class="sr-only">(estimate)</span></span></div>
      <div class="publication-tags">{article.tags.map((tag) => preview ? <span class="technical-badge">{tagLabel(tag)}</span> : <a class="technical-badge" href={tagHref(tag)}>{tagLabel(tag)}</a>)}</div>
    </header>
    {article.coverImage && <figure class="article-cover"><img src={article.coverImage} alt={article.coverAlt} width="1600" height="900" fetchpriority="high" decoding="async" /><figcaption class="metadata">{article.coverAlt}</figcaption></figure>}
    <div class="article-layout">
      <aside class="article-margin">
        {toc.length > 0 && <nav class="article-toc" aria-label="Table of contents"><p class="eyebrow">In this note</p><ol>{toc.map((heading) => <li class:list={{ "toc-subheading": heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol><a class="text-link toc-start" href="#article-body">Start reading <span class="arrow arrow-down" aria-hidden="true"></span></a></nav>}
      </aside>
      <div id="article-body" class="prose article-prose" tabindex="-1"><Content components={mdxComponents} /></div>
    </div>
    {!preview && <>
      {(previous || next) && <nav class="article-pagination" aria-label="Previous and next articles">
        {previous && <a href={articleHref(previous.id)}><span class="metadata">Previous note</span><span>{previous.data.title}</span></a>}
        {next && <a href={articleHref(next.id)}><span class="metadata">Next note</span><span>{next.data.title}</span></a>}
      </nav>}
      {related.length > 0 && <section class="article-related" aria-labelledby="related-title"><h2 id="related-title" class="section-title">Related notes</h2>{related.map((entry) => <ArticleCard article={entry} />)}</section>}
      <aside class="article-subscribe"><p>New notes arrive by RSS as they are published.</p><a class="text-link" href="/rss.xml">Follow via RSS <span class="arrow" aria-hidden="true"></span></a></aside>
    </>}
  </article>
  <script>import "../../scripts/article";</script>
</Layout>
