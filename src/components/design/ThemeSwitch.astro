---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<button type="button" class:list={["theme-switch button button-outline", { "theme-switch-compact": compact }]} data-theme-toggle aria-label="Use dark theme" aria-pressed="false" hidden>
  <svg class="theme-icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z" /></svg>
  <svg class="theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
  <span class="theme-switch-label">Theme</span>
</button>
