---
import { PROFILE } from "@/data/profile";
import { CONTACT_DETAILS, emailHref } from "@/data/contact";
---
<footer class="site-footer">
  <div class="site-container footer-grid">
    <div><a href="/" class="footer-brand">Rokon<span class="text-primary">.</span></a><p class="metadata mt-3">Systems in Motion</p></div>
    <p class="footer-note">Thoughtful interfaces.<br />Connected systems.</p>
    <nav aria-label="Footer" class="footer-links">
      {PROFILE.contacts.map((contact) => <a class="text-link" href={contact.url} target="_blank" rel="noopener noreferrer">{contact.label} <span aria-hidden="true">↗</span></a>)}
      {CONTACT_DETAILS.linkedin && <a class="text-link" href={CONTACT_DETAILS.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>}
      {CONTACT_DETAILS.email && <a class="text-link" href={emailHref(CONTACT_DETAILS.email)}>Email <span aria-hidden="true">↗</span></a>}
      <a class="text-link" href="/about">About</a>
      <a class="text-link" href="/contact">Contact</a>
      <a class="text-link" href="/resume">Resume</a>
      <a class="text-link" href="/blog">Writing</a>
      <a class="text-link" href="/rss.xml">RSS</a>
      <a class="text-link" href="/work">Work</a>
      <a class="text-link" href="/design-system">Design system</a>
    </nav>
  </div>
  <div class="site-container footer-bottom"><span class="metadata">© {new Date().getUTCFullYear()} {PROFILE.name}</span><a class="metadata text-link" href="#main-content">Back to top ↑</a></div>
</footer>
